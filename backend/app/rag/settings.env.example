# Merge into server/container environment. No secret is required for local tests.
RAG_DATABASE_URL=postgresql://dima:replace_me@127.0.0.1:5432/dima_rag
# MVP from IMPLEMENTATION_PLAN: PostgreSQL FTS without an embedding model.
# Set hybrid explicitly only for the existing E5 + pgvector index.
RAG_SEARCH_MODE=fts
RAG_MODEL_CACHE=/srv/alfa-models
# Use the same pinned model commit on BOTH replicas; changing it requires reindexing.
RAG_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_LOCAL_FILES_ONLY=1
RAG_BATCH_SIZE=8
RAG_CPU_THREADS=2
TOKENIZERS_PARALLELISM=false
# TESSDATA_PREFIX: set only if PyMuPDF cannot discover installed language files.
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
