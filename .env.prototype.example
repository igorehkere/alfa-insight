# Copy to .env.prototype, fill secrets, never commit that file.
POSTGRES_DB=alfa_insight
POSTGRES_USER=alfa
# Use a long hex password, so it needs no URL encoding in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_long_random_hex_password
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_FALLBACK_BASE_URL=https://api.alfahack-gateway26.ru/v1
LLM_API_KEY=replace_with_your_key
LLM_MODEL=deepseek-v4.1
LLM_TIMEOUT_SECONDS=30
LLM_REASONING_EFFORT=none
LLM_JSON_MODE=true
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
