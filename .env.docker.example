# Copy to .env.docker on your PC, or .env next to compose.yaml on the VM.
DOCKERHUB_USERNAME=your_dockerhub_username
# Use a new, immutable tag for each release, e.g. 2026-10-25-1.
IMAGE_TAG=2026-10-25-1

POSTGRES_DB=alfa_insight
POSTGRES_USER=alfa
# Generate with: openssl rand -hex 32. Use only hex characters (URL-safe).
POSTGRES_PASSWORD=replace_with_random_hex_password

LLM_API_KEY=replace_with_your_key
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_FALLBACK_BASE_URL=https://api.alfahack-gateway26.ru/v1
LLM_MODEL=deepseek-v4.1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=256
LLM_REASONING_EFFORT=none
LLM_JSON_MODE=true

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
# Fetch RSS on initial deployment when the news table is empty.
FETCH_NEWS_ON_INIT=true
